{
  "name": "dsh-model-vision",
  "version": "0.5.2",
  "description": "让 DSH 自动认出哪些模型能看图：点「获取可用模型」后自动补上「输入类型：图片」，并在模型名后标出「可看图」，不再报「模型不支持图片输入」",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "pi-ai",
    "vision",
    "图片输入",
    "视觉",
    "多模态",
    "image-input",
    "input-modalities"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./probe": "./lib/probe.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "tools",
    "test",
    "assets/icon-180.png",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/vision.test.mjs && node test/wiring.test.mjs && node test/probe.test.mjs && node test/oneclick.test.mjs && node test/contract.test.mjs",
    "preview": "node tools/preview.mjs",
    "check": "node tools/check.mjs",
    "prepublishOnly": "node test/vision.test.mjs && node test/wiring.test.mjs && node test/probe.test.mjs && node test/oneclick.test.mjs && node test/contract.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.5-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "license": "MIT",
  "icon": "assets/icon-180.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/charovo0059/dsh-model-vision.git"
  },
  "homepage": "https://github.com/charovo0059/dsh-model-vision#readme",
  "author": "charovo0059",
  "bugs": {
    "url": "https://github.com/charovo0059/dsh-model-vision/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
